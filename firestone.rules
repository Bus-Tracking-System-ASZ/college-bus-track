rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // --------------------------------------------------
    // Helper functions
    // --------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isStudent() {
      return signedIn()
        && currentUser().data.role == "STUDENT";
    }

    function isDriver() {
      return signedIn()
        && currentUser().data.role == "DRIVER";
    }

    function isAdmin() {
      return signedIn()
        && currentUser().data.role == "ADMIN";
    }


    // --------------------------------------------------
    // USERS
    // --------------------------------------------------

    match /users/{userId} {

      // User can read their own profile.
      allow read: if signedIn()
                  && request.auth.uid == userId;

      // User can create their own profile.
      allow create: if signedIn()
                    && request.auth.uid == userId;

      // User can update their own profile,
      // but cannot change their role.
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role
                       == resource.data.role;

      // Only admin can delete users.
      allow delete: if isAdmin();
    }


    // --------------------------------------------------
    // BUSES
    // --------------------------------------------------

    match /buses/{busId} {

      // Students can view buses.
      allow read: if signedIn();

      // Drivers and admins can modify buses.
      allow create, update: if isDriver() || isAdmin();

      allow delete: if isAdmin();
    }


    // --------------------------------------------------
    // ROUTES
    // --------------------------------------------------

    match /routes/{routeId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // --------------------------------------------------
    // STOPS
    // --------------------------------------------------

    match /stops/{stopId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // --------------------------------------------------
    // BUS LOCATIONS
    // --------------------------------------------------

    match /busLocations/{busId} {

      allow read: if signedIn();

      // Driver can update location.
      allow create, update: if isDriver() || isAdmin();

      allow delete: if isAdmin();
    }


    // --------------------------------------------------
    // SCHEDULES
    // --------------------------------------------------

    match /schedules/{scheduleId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // --------------------------------------------------
    // NOTIFICATIONS
    // --------------------------------------------------

    match /notifications/{notificationId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // --------------------------------------------------
    // DEVICE TOKENS
    // --------------------------------------------------

    match /deviceTokens/{tokenId} {

      allow read: if isAdmin();

      allow create: if signedIn()
                    && request.resource.data.uid
                       == request.auth.uid;

      allow update: if signedIn()
                    && resource.data.uid
                       == request.auth.uid;

      allow delete: if signedIn()
                    && resource.data.uid
                       == request.auth.uid;
    }


    // --------------------------------------------------
    // DENY EVERYTHING ELSE
    // --------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}